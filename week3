* {                        
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: 'Times New Roman', serif;
}

body {
    overflow-x: hidden;  
}

#jumpMenu {          
    position: fixed; 
    top: 0;
    left: 0;
    width: 200px;   
    height: 100vh;  
    background-color: #DAA520; 
    padding: 20px;
    overflow-y: auto;
    border-right: 1px solid #000;
    z-index: 100;
}

#jumpMenu h2 {
    margin-bottom: 20px;
    font-size: 30px;
    text-align: center;
}

#jumpMenu a {
    text-decoration: underline;
    color: blue;
    display: block;
    margin-bottom: 15px;
    font-size: 18px;
    text-align: center;
}

#jumpMenu a:visited {
    color: purple;
}

main {                  
    margin-left: 200px; 
    padding-top: 140px;
    padding-bottom: 50px; 
    background-color:white;
}

header {               
    position: fixed;   
    top: 0;
    left: 200px;       
    width: calc(100% - 200px);
    z-index: 50;      
    background-color: aliceblue;
}


header p {                   
    background-color: red;
    color: black;
    font-size: 30px;
    text-align: center;     
    padding: 20px 0;
    font-family:'Gill Sans', 'Gill Sans MT', 'Trebuchet MS', sans-serif;;
}

header nav {                 
    background-color: black;
    display: flex;
    justify-content: space-between; 
    padding: 0 50px;          
    gap: 50px;               
}

header nav button {   
    background-color: blue;
    border: none;
    color:aliceblue;
    font-size: 25px;
    cursor: pointer;
    font-family: 'Gill Sans', 'Gill Sans MT', 'Trebuchet MS', sans-serif;
    font-weight: lighter;
    padding: 15px 0; 
    flex-grow: 1;    
}

h1 {                   
    text-align: center;
    margin: 20px 0;
    font-size: 45px;
    font-weight: bold;
}

#container {         
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 40px;       
    padding: 0 40px; 
}

article h2 {
    font-size: 25px;
    margin-bottom: 10px;
    font-family:'Gill Sans', 'Gill Sans MT', 'Trebuchet MS', sans-serif;
    font-weight: normal;
    margin-left: 30px;
    margin-right: 30px;
}

article p {
    line-height: 1.1;
    margin-bottom: 10px;
    text-align: justify;
    font-family: sans-serif;
    font-size: 14px;
    margin-left: 30px;
    margin-right: 30px;
    width: 300px;
}

article a {
    color:darkblue;
    text-decoration: underline;
    font-family: sans-serif;
    font-size: 12px;
}

#thanks {           
    position: fixed; 
    bottom: 0;
    right: 0;
    background-color:lightskyblue; 
    padding: 20px 40px;
    font-size: 40px;
    border: 1px solid #000;
    z-index: 200; 
    margin: 0;     
}

footer {           
    margin-top: 30px;
    padding: 20px;
    background-color: aliceblue;
    text-align: center;
}

address div {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-style: normal;
}